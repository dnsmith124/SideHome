<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The Future pane's weather (§4a): two GETs to Open-Meteo, on view, when the cache is stale.
         Deliberately the launcher's *only* permission. There is no ACCESS_*_LOCATION here and there
         won't be: the place is typed and geocoded, not sensed. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Wallpaper sync (SID-180): keep the system/lock wallpaper matched to the theme so go-home
         and app-close transitions don't flash whatever wallpaper predates the launcher. Normal
         permission, and consent-gated in-app besides — nothing is set before the user approves. -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <!-- See every launchable app so the drawer can list them (package visibility, API 30+). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SideHome">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:theme="@style/Theme.SideHome"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Launcher settings. Registering APPLICATION_PREFERENCES makes the OS app-info page
             show a "Settings" deep-link straight into this screen (§6 gear wires in later). -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="true"
            android:label="@string/settings_title"
            android:theme="@style/Theme.SideHome">
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Notification-dot source of truth (§8). Exported so the system process can bind it, and
             guarded by BIND_NOTIFICATION_LISTENER_SERVICE so *only* the system can: the OS binds
             this only while the user has granted notification access, and never otherwise. -->
        <service
            android:name=".notifications.BadgeListenerService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>

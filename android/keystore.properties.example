# Copy this file to `keystore.properties` (gitignored) and fill in real values to sign release builds
# with your own key. Without this file, `assembleRelease` falls back to the debug key so the build stays
# installable for testing, but is NOT suitable for shipping to users (debug keys are shared/insecure, and
# app updates must be signed with the same key you first ship with).
#
# Create a keystore once:
#   keytool -genkey -v -keystore sidehome-release.jks -alias sidehome \
#           -keyalg RSA -keysize 2048 -validity 10000
#
# Then point storeFile at it (path relative to the android/ project dir):

storeFile=sidehome-release.jks
storePassword=CHANGE_ME
keyAlias=sidehome
keyPassword=CHANGE_ME
